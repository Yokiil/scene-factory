#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Objects"
    {
        def Cube "robot_mount_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/Materials/MetalContact>
            custom float physxCollision:contactOffset = 0.0001
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
            custom string sceneFactory:category = "support"
            custom string sceneFactory:objectId = "robot_mount_1"
            double size = 1
            float3 xformOp:scale = (0.5, 0.6, 0.78)
            double3 xformOp:translate = (-0.05, 0, 0.39)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "table_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/Materials/MetalContact>
            custom float physxCollision:contactOffset = 0.0001
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.48, 0.35, 0.23)]
            custom string sceneFactory:category = "support"
            custom string sceneFactory:objectId = "table_1"
            double size = 1
            float3 xformOp:scale = (0.7, 0.8, 0.92)
            double3 xformOp:translate = (0.7, 0, 0.46)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "socket_1"
        {
            custom string sceneFactory:category = "socket"
            custom string sceneFactory:objectId = "socket_1"
            double3 xformOp:translate = (0.6, 0.13, 0.96)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Base" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Materials/MetalContact>
                custom float physxCollision:contactOffset = 0.0001
                custom float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
                double size = 1
                float3 xformOp:scale = (0.07, 0.07, 0.02)
                double3 xformOp:translate = (0, 0, -0.03)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Xminus1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Materials/MetalContact>
                custom float physxCollision:contactOffset = 0.0001
                custom float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
                double size = 1
                float3 xformOp:scale = (0.02425, 0.07, 0.06)
                double3 xformOp:translate = (-0.022875, 0, 0.01)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Yminus1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Materials/MetalContact>
                custom float physxCollision:contactOffset = 0.0001
                custom float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
                double size = 1
                float3 xformOp:scale = (0.0215, 0.02425, 0.06)
                double3 xformOp:translate = (0, -0.022875, 0.01)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "X1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Materials/MetalContact>
                custom float physxCollision:contactOffset = 0.0001
                custom float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
                double size = 1
                float3 xformOp:scale = (0.02425, 0.07, 0.06)
                double3 xformOp:translate = (0.022875, 0, 0.01)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Y1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Materials/MetalContact>
                custom float physxCollision:contactOffset = 0.0001
                custom float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
                double size = 1
                float3 xformOp:scale = (0.0215, 0.02425, 0.06)
                double3 xformOp:translate = (0, 0.022875, 0.01)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Cylinder "peg_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.1
            rel material:binding:physics = </World/Materials/MetalContact>
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00006866667, 0.00006866667, 0.000004)
            float physics:mass = 0.08
            custom float physxCollision:contactOffset = 0.0001
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.82)]
            double radius = 0.01
            custom string sceneFactory:category = "peg"
            custom string sceneFactory:objectId = "peg_1"
            double3 xformOp:translate = (0.55, -0.13, 0.97)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 800
    }

    def "Materials"
    {
        def Material "MetalContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }
    }

    def "Room"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/Materials/MetalContact>
            custom float physxCollision:contactOffset = 0.0001
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)]
            double size = 1
            float3 xformOp:scale = (4, 4, 0.05)
            double3 xformOp:translate = (0, 0, -0.025)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

