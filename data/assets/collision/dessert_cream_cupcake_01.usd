#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" {
    def Scope "Materials" {
        def Material "M0" {
            token outputs:surface.connect = </Asset/Materials/M0/Shader.outputs:surface>
            def Shader "Shader" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.34, 0.16)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
        def Material "Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
            float physics:staticFriction = 0.55
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
        }
    }
    def Mesh "Body" (prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]) {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(-0.046, -0.046, -0.055), (0.046, -0.046, -0.055), (0.046, 0.046, -0.055), (-0.046, 0.046, -0.055), (-0.046, -0.046, 0.055), (0.046, -0.046, 0.055), (0.046, 0.046, 0.055), (-0.046, 0.046, 0.055)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        rel material:binding = </Asset/Materials/M0>
        token visibility = "invisible"
        bool physics:collisionEnabled = true
        token physics:approximation = "convexHull"
        rel material:binding:physics = </Asset/Materials/Physics>
    }
}
